<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!--根据名称自动装配：autowire="byName"-->
	<bean id="userController" class="com.lxcecho.xml.ioc.controller.UserController" autowire="byName"/>
	<bean id="userService" class="com.lxcecho.xml.ioc.service.impl.UserServiceImpl" autowire="byName"/>
	<bean id="userDao" class="com.lxcecho.xml.ioc.dao.impl.UserDaoImpl"/>
</beans>