<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="empone" class="com.lxcecho.xml.ioc.bean.Emp">
		<property name="ename" value="lucy"/>
		<property name="age" value="20"/>
	</bean>
	<bean id="emptwo" class="com.lxcecho.xml.ioc.bean.Emp">
		<property name="ename" value="mary"/>
		<property name="age" value="30"/>
	</bean>

	<bean id="dept" class="com.lxcecho.xml.ioc.bean.Dept">
		<property name="dname" value="技术部"/>
		<property name="empList">
			<list>
				<ref bean="empone"/>
				<ref bean="emptwo"/>
			</list>
		</property>
	</bean>
</beans>