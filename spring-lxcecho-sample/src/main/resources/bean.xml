<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!--完成 user 对象创建
		bean 标签
			id 属性：唯一标识
			class 属性：要创建对象所在类的全路径（包名称+类名称）
	-->
	<!--1 获取 bean 演示，user 对象创建-->
	<bean id="user" class="com.lxcecho.xml.ioc.bean.User"/>

	<bean id="user1" class="com.lxcecho.xml.ioc.bean.User"/>

	<!--2 一个接口实现类获取过程，注意：此时因为 UserDao 有两个实现类，IOC 获取 UserDao 对象的时候会报错：-->
	<!--org.springframework.beans.factory.NoUniqueBeanDefinitionException: No qualifying bean of type
	'com.lxcecho.xml.ioc.dao.UserDao' available: expected single matching bean but found 2: userDaoImpl,personDaoImpl-->
	<bean id="userDaoImpl" class="com.lxcecho.xml.ioc.dao.impl.UserDaoImpl"/>
	<bean id="personDaoImpl" class="com.lxcecho.xml.ioc.dao.impl.PersonDaoImpl"/>
</beans>