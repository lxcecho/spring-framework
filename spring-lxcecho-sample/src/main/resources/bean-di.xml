<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!--1 set 方法注入-->
	<bean id="book" class="com.lxcecho.xml.ioc.bean.Book">
		<property name="bname" value="WWW"/>
		<property name="author" value="BBB"/>
		<!--        <property name="others">-->
		<!--            <null/>-->
		<!--        </property>-->
		<!--        <property name="others" value="&lt;&gt;"></property>-->
		<property name="others">
			<value><![CDATA[a < b]]></value>
		</property>
	</bean>

	<!--2 构造器注入-->
	<bean id="bookCon" class="com.lxcecho.xml.ioc.bean.Book">
		<constructor-arg name="bname" value="CCC"/>
		<constructor-arg name="author" value="AAA"/>
	</bean>

</beans>