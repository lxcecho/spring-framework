<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!--
		1 创建两个对象
		2 注入普通类型属性
		3 在学生bean注入map集合类型属性
	-->
	<bean id="teacherone" class="com.lxcecho.xml.ioc.bean.Teacher">
		<!--注入普通类型属性-->
		<property name="teacherId" value="100"/>
		<property name="teacherName" value="西门讲师"/>
	</bean>
	<bean id="teachertwo" class="com.lxcecho.xml.ioc.bean.Teacher">
		<!--注入普通类型属性-->
		<property name="teacherId" value="200"/>
		<property name="teacherName" value="上官讲师"/>
	</bean>

	<bean id="student" class="com.lxcecho.xml.ioc.bean.Student">
		<!--注入普通类型属性-->
		<property name="sid" value="2000"/>
		<property name="sname" value="张三"/>
		<!--在学生bean注入map集合类型属性-->
		<property name="teacherMap">
			<map>
				<entry key="10010" value-ref="teacherone"/>
				<entry key="10086" value-ref="teachertwo"/>
			</map>
		</property>
	</bean>
</beans>